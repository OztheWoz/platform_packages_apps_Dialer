<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:layout_marginStart="@dimen/incall_window_margin_horizontal"
  android:layout_marginEnd="@dimen/incall_window_margin_horizontal"
  tools:showIn="@layout/frag_incall_voice">
  <com.android.dialer.widget.MaxHeightScrollView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:fadeScrollbars="false"
    android:scrollbars="vertical"
    android:scrollbarSize="8dp"
    app:maxHeight="@dimen/incall_button_grid_scroll_view_max_height">
    <GridLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:columnCount="3"
      android:orientation="horizontal">
      <com.android.incallui.incall.impl.MaterialLabeledButton
        android:id="@+id/incall_first_button"
        style="@style/InCall.Button.IconText"
        android:layout_width="0dp"
        android:layout_columnWeight="1"
        android:enabled="false"
        android:text="@string/incall_label_mute"
        tools:layout_height="@dimen/tools_button_height"
        tools:layout_width="@dimen/incall_labeled_button_size"/>
      <com.android.incallui.incall.impl.MaterialLabeledButton
        android:id="@+id/incall_second_button"
        style="@style/InCall.Button.IconText"
        android:layout_width="0dp"
        android:layout_columnWeight="1"
        android:enabled="false"
        android:text="@string/incall_label_dialpad"
        tools:layout_height="@dimen/tools_button_height"
        tools:layout_width="@dimen/incall_labeled_button_size"/>
      <com.android.incallui.incall.impl.MaterialLabeledButton
        android:id="@+id/incall_third_button"
        style="@style/InCall.Button.IconText"
        android:layout_width="0dp"
        android:layout_columnWeight="1"
        android:enabled="false"
        android:text="@string/incall_label_speaker"
        tools:layout_height="@dimen/tools_button_height"
        tools:layout_width="@dimen/incall_labeled_button_size"/>
      <com.android.incallui.incall.impl.MaterialLabeledButton
        android:id="@+id/incall_fourth_button"
        style="@style/InCall.Button.IconText"
        android:layout_marginTop="@dimen/incall_button_vertical_padding"
        android:layout_width="0dp"
        android:layout_columnWeight="1"
        android:text="@string/incall_label_add_call"
        tools:layout_height="@dimen/tools_button_height"
        tools:layout_width="@dimen/incall_labeled_button_size"/>
      <com.android.incallui.incall.impl.MaterialLabeledButton
        android:id="@+id/incall_fifth_button"
        style="@style/InCall.Button.IconText"
        android:layout_width="0dp"
        android:layout_columnWeight="1"
        android:layout_marginTop="@dimen/incall_button_vertical_padding"
        android:text="@string/incall_label_hold"
        tools:layout_height="@dimen/tools_button_height"
        tools:layout_width="@dimen/incall_labeled_button_size"/>
      <com.android.incallui.incall.impl.MaterialLabeledButton
        android:id="@+id/incall_sixth_button"
        style="@style/InCall.Button.IconText"
        android:layout_width="0dp"
        android:layout_columnWeight="1"
        android:layout_marginTop="@dimen/incall_button_vertical_padding"
        android:text="@string/incall_label_videocall"
        tools:layout_height="@dimen/tools_button_height"
        tools:layout_width="@dimen/incall_labeled_button_size"/>
      <com.android.incallui.incall.impl.MaterialLabeledButton
          android:id="@+id/incall_seventh_button"
          style="@style/InCall.Button.IconText"
          android:layout_width="0dp"
          android:layout_columnWeight="1"
          android:layout_marginTop="@dimen/incall_button_vertical_padding"
          tools:layout_height="@dimen/tools_button_height"
          tools:layout_width="@dimen/incall_labeled_button_size"/>
      <com.android.incallui.incall.impl.MaterialLabeledButton
          android:id="@+id/incall_eighth_button"
          style="@style/InCall.Button.IconText"
          android:layout_width="0dp"
          android:layout_columnWeight="1"
          android:layout_marginTop="@dimen/incall_button_vertical_padding"
          tools:layout_height="@dimen/tools_button_height"
          tools:layout_width="@dimen/incall_labeled_button_size"/>
      <com.android.incallui.incall.impl.MaterialLabeledButton
          android:id="@+id/incall_ninth_button"
          style="@style/InCall.Button.IconText"
          android:layout_width="0dp"
          android:layout_columnWeight="1"
          android:layout_marginTop="@dimen/incall_button_vertical_padding"
          tools:layout_height="@dimen/tools_button_height"
          tools:layout_width="@dimen/incall_labeled_button_size"/>
      <com.android.incallui.incall.impl.MaterialLabeledButton
          android:id="@+id/incall_tenth_button"
          style="@style/InCall.Button.IconText"
          android:layout_width="0dp"
          android:layout_columnWeight="1"
          android:layout_marginTop="@dimen/incall_button_vertical_padding"
          tools:layout_height="@dimen/tools_button_height"
          tools:layout_width="@dimen/incall_labeled_button_size"/>
      <com.android.incallui.incall.impl.MaterialLabeledButton
          android:id="@+id/incall_eleventh_button"
          style="@style/InCall.Button.IconText"
          android:layout_width="0dp"
          android:layout_columnWeight="1"
          android:layout_marginTop="@dimen/incall_button_vertical_padding"
          tools:layout_height="@dimen/tools_button_height"
          tools:layout_width="@dimen/incall_labeled_button_size"/>
      <com.android.incallui.incall.impl.MaterialLabeledButton
          android:id="@+id/incall_twelfth_button"
          style="@style/InCall.Button.IconText"
          android:layout_width="0dp"
          android:layout_columnWeight="1"
          android:layout_marginTop="@dimen/incall_button_vertical_padding"
          tools:layout_height="@dimen/tools_button_height"
          tools:layout_width="@dimen/incall_labeled_button_size"/>
    </GridLayout>
  </com.android.dialer.widget.MaxHeightScrollView>
</FrameLayout>
