<!-- MD3 Action Bar: 4-column button rows with expandable "More" section -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="16dp"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    tools:showIn="@layout/frag_incall_voice">

  <!-- Expandable Rows Container (Row 2+) -->
  <LinearLayout
      android:id="@+id/incall_extra_rows"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:visibility="gone"
      tools:visibility="visible">

    <!-- Row 2: Hold, Add call, Swap, Merge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="8dp">

      <com.android.incallui.incall.impl.MaterialLabeledButton
          android:id="@+id/incall_fifth_button"
          style="@style/InCall.Button.IconText"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="@string/incall_label_hold"/>

      <com.android.incallui.incall.impl.MaterialLabeledButton
          android:id="@+id/incall_fourth_button"
          style="@style/InCall.Button.IconText"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="@string/incall_label_add_call"/>

      <com.android.incallui.incall.impl.MaterialLabeledButton
          android:id="@+id/incall_sixth_button"
          style="@style/InCall.Button.IconText"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="@string/incall_label_swap"/>

      <com.android.incallui.incall.impl.MaterialLabeledButton
          android:id="@+id/incall_seventh_button"
          style="@style/InCall.Button.IconText"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="@string/incall_label_merge"/>
    </LinearLayout>

    <!-- Row 3: Record, Video, RTT, Manage -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="8dp">

      <com.android.incallui.incall.impl.MaterialLabeledButton
          android:id="@+id/incall_eighth_button"
          style="@style/InCall.Button.IconText"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="@string/incall_label_record"/>

      <com.android.incallui.incall.impl.MaterialLabeledButton
          android:id="@+id/incall_ninth_button"
          style="@style/InCall.Button.IconText"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="@string/incall_label_videocall"/>

      <com.android.incallui.incall.impl.MaterialLabeledButton
          android:id="@+id/incall_tenth_button"
          style="@style/InCall.Button.IconText"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="@string/incall_label_rttcall"/>

      <com.android.incallui.incall.impl.MaterialLabeledButton
          android:id="@+id/incall_eleventh_button"
          style="@style/InCall.Button.IconText"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="@string/incall_label_manage"/>
    </LinearLayout>

    <!-- Row 4: Extra buttons if needed -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="8dp"
        android:visibility="gone">

      <com.android.incallui.incall.impl.MaterialLabeledButton
          android:id="@+id/incall_twelfth_button"
          style="@style/InCall.Button.IconText"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"/>
    </LinearLayout>

  </LinearLayout>

  <!-- Main Row (always visible): Keypad, Mute, Speaker, More -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:gravity="center">

    <com.android.incallui.incall.impl.MaterialLabeledButton
        android:id="@+id/incall_second_button"
        style="@style/InCall.Button.IconText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/incall_label_dialpad"/>

    <com.android.incallui.incall.impl.MaterialLabeledButton
        android:id="@+id/incall_first_button"
        style="@style/InCall.Button.IconText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/incall_label_mute"/>

    <com.android.incallui.incall.impl.MaterialLabeledButton
        android:id="@+id/incall_third_button"
        style="@style/InCall.Button.IconText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/incall_label_speaker"/>

    <!-- More button to expand/collapse extra rows -->
    <com.android.incallui.incall.impl.MaterialLabeledButton
        android:id="@+id/incall_more_button"
        style="@style/InCall.Button.IconText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/incall_label_more"
        app:icon="@drawable/quantum_ic_more_vert_vd_theme_24"
        xmlns:app="http://schemas.android.com/apk/res-auto"/>

  </LinearLayout>

</LinearLayout>
